.topbar { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(13px); -webkit-backdrop-filter: blur(13px); }
.topbar-inner { display: flex; align-items: center; gap: 12px; min-height: 58px; }
.brand { display: inline-flex; align-items: center; gap: 9px; flex: 1; min-width: 0; color: var(--ink); font-size: 15px; font-weight: 900; white-space: nowrap; }
.brand-mark { display: grid; width: 31px; height: 31px; flex: 0 0 auto; place-items: center; overflow: hidden; border-radius: 9px; background: var(--accent); }
.brand-mark svg { width: 100%; height: 100%; }
.nav-link, .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); cursor: pointer; font-size: 13px; font-weight: 600; text-decoration: none; transition: transform .22s ease, border-color .22s ease, background-color .22s ease, color .22s ease, box-shadow .22s ease; }
.nav-link { padding: 6px 12px; white-space: nowrap; }
.nav-link:hover, .btn:hover { border-color: var(--accent-line); color: var(--accent); text-decoration: none; transform: translateY(-2px); }
.btn { padding: 9px 17px; }
.btn.sm { padding: 6px 12px; font-size: 12px; }
.btn.icon { width: 36px; height: 36px; padding: 7px; }
.btn.primary { border-color: var(--accent); background: var(--accent); color: var(--bg); }
.btn.primary:hover { border-color: var(--accent); color: var(--bg); box-shadow: 0 8px 22px var(--accent-soft); filter: brightness(1.08); }
.btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }
html[data-theme="light"] .moon, html[data-theme="dark"] .sun { display: none; }
.hero { position: relative; overflow: hidden; padding: 66px 0 62px; border-bottom: 1px solid var(--line); }
.hero::after { position: absolute; right: -150px; bottom: -180px; width: 460px; height: 460px; border: 1px solid var(--accent-line); border-radius: 50%; content: ""; opacity: .18; pointer-events: none; }
.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: 48px; }
.hero-copy { animation: fade-up .7s ease-out both; }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 15px; color: var(--accent); font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
.eyebrow::before { width: 32px; height: 2px; background: var(--amber); content: ""; }
.hero h1 { max-width: 14ch; font-size: clamp(34px, 5vw, 60px); font-weight: 900; line-height: 1.28; letter-spacing: -.025em; }
.underword { position: relative; display: inline-block; white-space: nowrap; }
.underword::after { position: absolute; right: 0; bottom: -7px; left: 0; height: 8px; border-bottom: 3px solid var(--amber); border-radius: 50%; content: ""; transform: rotate(-1deg); }
.hero-lead { max-width: 57ch; margin-top: 22px; color: var(--muted); font-size: clamp(16px, 2vw, 19px); line-height: 1.95; }
.hero-note { max-width: 59ch; margin-top: 18px; padding: 13px 16px; border-inline-start: 3px solid var(--accent); border-radius: 0 9px 9px 0; background: var(--accent-soft); font-size: 13.5px; line-height: 1.9; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 25px; }
.hero-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 25px; }
.hero-chips a { padding: 4px 10px; border: 1px solid var(--line); border-radius: 99px; background: var(--surface); color: var(--muted); font-size: 11.5px; transition: transform .22s ease, border-color .22s ease, color .22s ease; }
.hero-chips a:hover { border-color: var(--accent-line); color: var(--accent); text-decoration: none; transform: translateY(-2px); }
.hero-chips b { margin-inline-end: 4px; color: var(--accent); font-family: var(--mono); font-size: 10px; }
.architecture { overflow: hidden; border: 1px solid var(--line-strong); border-radius: 17px; background: var(--code-bg); box-shadow: var(--shadow-lg); animation: fade-up .8s .12s ease-out both; display: flex; flex-direction: column; }
.window-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.04); direction: ltr; }
.window-bar i { width: 11px; height: 11px; border-radius: 50%; }
.window-bar i:nth-child(1) { background: #e0655a; }
.window-bar i:nth-child(2) { background: #e5b45a; }
.window-bar i:nth-child(3) { background: #58b78c; }
.window-bar span { margin-inline-start: 10px; color: var(--code-muted); font: 11px var(--mono); }
.architecture-query { padding: 14px 20px 6px; min-height: 52px; color: var(--code-ink); direction: ltr; font: 12.5px/1.8 var(--mono); display: flex; align-items: center; white-space: pre-wrap; }
.architecture-query .kw { color: #7fc79f; }
.architecture-query .str { color: #e5b45a; }
.architecture-query .comment { color: #6e7f70; }
.cursor-blink { display: inline-block; width: 8px; height: 16px; background: #5cc08f; margin-inline-start: 2px; animation: blink 1s step-end infinite; }
.architecture-caption { min-height: 46px; padding: 9px 16px 13px; border-top: 1px solid rgba(255,255,255,.07); color: var(--code-muted); font-size: 12px; line-height: 1.75; text-align: center; }

/* ============ Hero live flow ============ */
.flow { position: relative; --flowY: 62px; padding: 30px 16px 6px; direction: ltr; }
.flow-line { position: absolute; z-index: 1; left: 10%; right: 10%; top: calc(var(--flowY) - 1px); height: 2px; border-radius: 2px; background: #26332b; overflow: hidden; }
.flow-line i { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, #4d705b 0 9px, transparent 9px 18px); animation: dashmove 1.15s linear infinite; opacity: .8; }
@keyframes dashmove { to { transform: translateX(18px); } }
.flow-stations { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(5, 1fr); }
.fstation { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.fs-bubble { display: grid; width: 52px; height: 52px; place-items: center; border: 1px solid #35483b; border-radius: 14px; background: #202a23; color: #8ca08e; transition: border-color .25s ease, box-shadow .25s ease, color .25s ease, transform .25s ease; }
.fs-bubble svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.fstation.active .fs-bubble { border-color: #e5b45a; color: #ffe3ae; box-shadow: 0 0 20px 3px rgba(229,180,90,.3); transform: translateY(-3px); }
.fstation.dst-glow .fs-bubble { border-color: #5cc08f; color: #b9f0d2; box-shadow: 0 0 18px 2px rgba(92,192,143,.35); }
.fs-name { color: #cfe0cf; font: 700 9.5px var(--mono); letter-spacing: .07em; text-transform: uppercase; }
.fs-sub { margin-top: -5px; color: #6e7f70; font: 9px var(--mono); }
.fs-gauge { width: 46px; height: 4px; overflow: hidden; border-radius: 3px; background: #26332b; }
.fs-gauge i { display: block; width: 0; height: 100%; border-radius: 3px; background: #5cc08f; transition: width .35s ease; }
.flow-packets { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
.packet {
position: absolute; top: var(--flowY); left: 10%; width: 34px; height: 22px; margin: -11px 0 0 -17px;
display: grid; place-items: center; border-radius: 6px;
border: 1px solid rgba(229,180,90,.55); background: rgba(229,180,90,.16);
color: #ffe3ae; font: 700 9px var(--mono);
box-shadow: 0 0 12px rgba(229,180,90,.28);
will-change: left, transform;
}
.packet.clean { border-color: rgba(92,192,143,.6); background: rgba(92,192,143,.16); color: #c9f2dc; box-shadow: 0 0 12px rgba(92,192,143,.3); }
.flow-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 16px 16px 14px; direction: ltr; }
.fstat { padding: 7px 8px; border: 1px solid #2f3d33; border-radius: 8px; background: #1a231d; color: #748c79; font: 600 8.5px var(--mono); letter-spacing: .08em; text-transform: uppercase; text-align: center; }
.fstat b { display: block; margin-top: 2px; color: #d5e0d2; font-size: 12.5px; letter-spacing: .02em; }
.fstat b.ok { color: #5cc08f; }
.qswap { animation: qfade .45s ease; }
@keyframes qfade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

main { padding-bottom: 30px; }
.section { padding: 68px 0 0; scroll-margin-top: 74px; }
.section+.section { border-top: 1px dashed var(--line-strong); margin-top: 60px; padding-top: 62px; }
.section-heading { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px; }
.section-number { display: inline-grid; min-width: 39px; height: 31px; place-items: center; border: 1px solid var(--accent-line); border-radius: 8px; background: var(--accent-soft); color: var(--accent); font: 700 12px var(--mono); }
.section h2 { font-size: clamp(23px, 3.2vw, 33px); font-weight: 800; line-height: 1.45; }
.lead { max-width: 78ch; margin-bottom: 22px; font-size: 17px; line-height: 2; }
.sublead { max-width: 78ch; margin-bottom: 22px; color: var(--muted); font-size: 14.5px; line-height: 1.95; }
.source-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; }
.source-row a { display: inline-flex; align-items: center; gap: 6px; padding: 4px 11px; border: 1px solid var(--line); border-radius: 99px; background: var(--surface); color: var(--muted); font-size: 11.5px; }
.source-row a:hover { border-color: var(--accent-line); color: var(--accent); text-decoration: none; }
.grid-2, .grid-3 { display: grid; gap: 17px; margin: 23px 0; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.card { position: relative; padding: 22px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow); transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease; }
.card:hover { border-color: var(--accent-line); box-shadow: var(--shadow-lg); transform: translateY(-3px); }
.card h3 { display: flex; align-items: center; gap: 10px; margin-bottom: 11px; font-size: 15.5px; font-weight: 800; line-height: 1.55; }
.card p, .card li { color: var(--muted); font-size: 14px; line-height: 1.9; }
.card ul { padding-inline-start: 20px; }
.icon-box { display: grid; width: 33px; height: 33px; flex: 0 0 auto; place-items: center; border-radius: 9px; }
.icon-box.green { background: var(--accent-soft); color: var(--accent); }
.icon-box.amber { background: var(--amber-soft); color: var(--amber); }
.icon-box.red { background: var(--red-soft); color: var(--red); }
.icon-box.violet { background: var(--violet-soft); color: var(--violet); }
.icon-box.blue { background: var(--blue-soft); color: var(--blue); }
.callout { margin: 24px 0; padding: 17px 20px; border: 1px solid var(--accent-line); border-inline-start: 4px solid var(--accent); border-radius: 10px; background: var(--accent-soft); }
.callout.warning { border-color: rgba(194,120,3,.38); border-inline-start-color: var(--amber); background: var(--amber-soft); }
.callout strong.label { display: inline-block; margin-bottom: 7px; color: var(--accent); font: 700 11px var(--mono); letter-spacing: .04em; text-transform: uppercase; }
.callout.warning strong.label { color: var(--amber); }
.callout p { font-size: 14px; line-height: 1.95; }
.net-note { margin: 24px 0; padding: 18px 20px; border: 1px solid var(--accent-line); border-radius: 11px; background: var(--surface-alt); }
.net-note .badge { display: inline-block; margin-bottom: 8px; padding: 2px 9px; border-radius: 5px; background: var(--accent); color: var(--bg); font: 700 10px var(--mono); }
.net-note p { font-size: 14px; line-height: 1.95; }
.compare-wrap { overflow-x: auto; margin: 24px 0; border: 1px solid var(--line); border-radius: 11px; box-shadow: var(--shadow); }
.compare-table { width: 100%; min-width: 690px; border-collapse: collapse; font-size: 13px; }
.compare-table th, .compare-table td { padding: 12px 15px; border-bottom: 1px solid var(--line); text-align: start; vertical-align: top; }
.compare-table tr:last-child td { border-bottom: 0; }
.compare-table th { background: var(--surface-alt); color: var(--muted); font-size: 12px; }
.compare-table td { background: var(--surface); color: var(--muted); line-height: 1.8; }
.compare-table td:first-child { color: var(--ink); font-weight: 700; }
.good { color: var(--accent) !important; }
.caution { color: var(--amber) !important; }
.bad { color: var(--red) !important; }
.concept-diagram { display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: stretch; margin: 25px 0; }
.concept-side { display: grid; gap: 9px; align-content: center; padding: 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); text-align: center; }
.concept-side h3 { font-size: 15px; }
.concept-side p { color: var(--muted); font-size: 13px; line-height: 1.8; }
.concept-arrow { display: grid; min-width: 62px; place-items: center; color: var(--accent); font: 700 24px var(--mono); }
.concept-tag { display: inline-block; justify-self: center; padding: 3px 9px; border-radius: 5px; background: var(--surface-alt); color: var(--accent); font: 700 10px var(--mono); }
.codebox { margin: 24px 0; overflow: hidden; border: 1px solid rgba(0,0,0,.17); border-radius: 11px; background: var(--code-bg); direction: ltr; box-shadow: var(--shadow); }
.code-title { padding: 9px 16px; border-bottom: 1px solid rgba(255,255,255,.08); color: var(--code-muted); font: 11px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
.codebox pre { margin: 0; padding: 17px 19px; overflow-x: auto; color: var(--code-ink); font: 13px/1.75 var(--mono); text-align: left; white-space: pre; }
.codebox .kw { color: #7fc79f; }
.codebox .str { color: #e5b45a; }
.codebox .cm { color: #6e7f70; }
.codebox .fn { color: #d08b4f; }
.demo { margin: 29px 0; padding: 23px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); box-shadow: var(--shadow); }
.demo-title { display: flex; align-items: center; gap: 9px; padding-bottom: 13px; border-bottom: 1px dashed var(--line-strong); font-size: 16px; font-weight: 800; }
.demo-title .ic { color: var(--accent); }
.demo-intro { margin: 14px 0 17px; color: var(--muted); font-size: 13.5px; line-height: 1.9; }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.tab { padding: 8px 13px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--muted); cursor: pointer; font-size: 12.5px; font-weight: 700; transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
.tab:hover { border-color: var(--accent-line); color: var(--accent); transform: translateY(-1px); }
.tab[aria-selected="true"] { border-color: var(--accent); background: var(--accent); color: var(--bg); }

/* ============ Scan demo (row vs column) ============ */
.scan { overflow: hidden; border-radius: 12px; }
.scan-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.scan-query { padding: 7px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--code-bg); color: #7fc79f; font: 600 11.5px var(--mono); }
.scan .tabs { margin: 0; }
.scan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
.sc {
min-height: 32px; display: grid; place-items: center;
border: 1px solid var(--line); border-radius: 6px; background: var(--surface-alt);
color: var(--dim); font: 10.5px/1 var(--mono);
transition: background-color .2s ease, border-color .2s ease, color .2s ease, opacity .3s ease, transform .2s ease;
}
.sc.sh { border-style: dashed; background: transparent; color: var(--muted); font-weight: 700; font-size: 10px; letter-spacing: .05em; }
.sc.hit { border-color: var(--accent-line); background: var(--accent-soft); color: var(--accent); animation: cellpop .3s ease; }
.sc.rowhit { border-color: rgba(194,120,3,.5); background: var(--amber-soft); color: var(--amber); animation: cellpop .25s ease; }
.sc.dim { opacity: .3; }
@keyframes cellpop { 0% { transform: scale(.82); } 60% { transform: scale(1.07); } 100% { transform: scale(1); } }
.scan-io { margin-top: 14px; }
.io-track { height: 7px; overflow: hidden; border-radius: 4px; background: var(--surface-alt); border: 1px solid var(--line); }
