--accent: #5cc08f;
--accent-soft: rgba(92, 192, 143, .14);
--accent-line: rgba(92, 192, 143, .45);
--amber: #e3a63c;
--amber-soft: rgba(227, 166, 60, .14);
--red: #e5745a;
--red-soft: rgba(229, 116, 90, .12);
--violet: #d08b4f;
--violet-soft: rgba(208, 139, 79, .13);
--blue: #6ba8d4;
--blue-soft: rgba(107, 168, 212, .14);
--code-bg: #121813;
