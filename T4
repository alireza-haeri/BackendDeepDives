p code, li code, td code {
border: 1px solid var(--line); border-radius: 5px; padding: .04em .38em;
background: var(--surface-alt); color: var(--accent); font-size: .86em;
}
.wrap { width: min(1080px, calc(100% - 40px)); margin-inline: auto; }
.ic { width: 18px; height: 18px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
