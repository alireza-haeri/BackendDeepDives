$$('.reveal').forEach(el => obs.observe(el));

/* ===== Hero: live flying packets ===== */
const packetLayer = $('#packetLayer');
if (packetLayer) {
const stations = { e: $('#fsE'), t: $('#fsT'), l: $('#fsL'), dst: $('#fsDst') };
const gauge = $('#dstGauge');
const heroQuery = $('#heroQuery');
const statRows = $('#statRows'), statBatch = $('#statBatch'), statStatus = $('#statStatus');
const DUR = 4600;
const OFF = { e: .24, t: .50, l: .76, dst: .96 };
const pad = n => String(n).padStart(2, '0');
let rowsDone = 0;

function setQuery(html) {
heroQuery.innerHTML = html;
heroQuery.classList.remove('qswap');
void heroQuery.offsetWidth;
heroQuery.classList.add('qswap');
}
function flash(st) {
if (!st) return;
st.classList.add('active');
setTimeout(() => st.classList.remove('active'), 420);
}
function flashDst() {
stations.dst.classList.add('dst-glow');
setTimeout(() => stations.dst.classList.remove('dst-glow'), 420);
}
const EASE = 'cubic-bezier(.45,.05,.35,1)';
const KEYFRAMES = [
{ left: '10%', transform: 'translateY(0)', offset: 0 },
{ left: '10%', transform: 'translateY(0)', offset: .07 },
{ left: '20%', transform: 'translateY(-11px)', offset: .155, easing: EASE },
{ left: '30%', transform: 'translateY(0)', offset: .24, easing: EASE },
{ left: '30%', transform: 'translateY(0)', offset: .33 },
{ left: '40%', transform: 'translateY(-11px)', offset: .415, easing: EASE },
{ left: '50%', transform: 'translateY(0)', offset: .50, easing: EASE },
{ left: '50%', transform: 'translateY(0)', offset: .59 },
{ left: '60%', transform: 'translateY(-11px)', offset: .675, easing: EASE },
{ left: '70%', transform: 'translateY(0)', offset: .76, easing: EASE },
{ left: '70%', transform: 'translateY(0)', offset: .83 },
{ left: '80%', transform: 'translateY(-11px)', offset: .895, easing: EASE },
{ left: '90%', transform: 'translateY(0) scale(1)', offset: .96, easing: EASE },
{ left: '90%', transform: 'translateY(0) scale(.3)', opacity: 0, offset: 1 }
];
function spawnPacket(idx, delay) {
return new Promise(resolve => {
setTimeout(() => {
const p = document.createElement('div');
p.className = 'packet';
p.textContent = pad(idx + 1);
packetLayer.appendChild(p);
const anim = p.animate(KEYFRAMES, { duration: DUR, fill: 'forwards' });
setTimeout(() => p.classList.add('clean'), DUR * OFF.t);
setTimeout(() => flash(stations.e), DUR * OFF.e);
setTimeout(() => flash(stations.t), DUR * OFF.t);
setTimeout(() => flash(stations.l), DUR * OFF.l);
anim.onfinish = () => {
flashDst();
rowsDone++;
statRows.textContent = pad(rowsDone) + ' / 12';
gauge.style.width = (rowsDone / 12 * 100) + '%';
p.remove();
resolve();
};
}, delay);
});
}
async function heroLoop() {
while (true) {
if (document.hidden) { await sleep(800); continue; }
rowsDone = 0;
statRows.textContent = '00 / 12';
gauge.style.width = '0%';
packetLayer.innerHTML = '';
statStatus.textContent = 'RUNNING';
statStatus.classList.remove('ok');
setQuery('<span class="comment"># nightly job starts — 3 chunks of 4</span>');
setBilingual($('#heroCaption'), 'شغل شروع شد. دستهٔ اول در حال خواندن از دیتابیس عملیاتی است.', 'The job started. The first chunk is being read from the operational database.');
await sleep(700);
const promises = [];
for (let b = 0; b < 3; b++) {
statBatch.textContent = (b + 1) + ' / 3';
setQuery(`<span class="kw">EXTRACT</span> batch ${b + 1}/3  —  4 rows`);
setBilingual($('#heroCaption'),
`دستهٔ ${b + 1} از ۳: استخراج، تبدیل و بارگذاری — بدون توقف برای کاربر.`,
`Chunk ${b + 1} of 3: extract, transform, load — no user is waiting.`);
for (let i = 0; i < 4; i++) promises.push(spawnPacket(b * 4 + i, i * 140));
if (b < 2) await sleep(1600);
}
await Promise.all(promises);
statStatus.textContent = 'COMPLETE ✓';
statStatus.classList.add('ok');
setQuery('<span class="kw">JOB COMPLETE</span>  —  12 rows loaded');
setBilingual($('#heroCaption'), 'سه دسته تمام شد — ۱۲ رکورد، یک شغل، یک خروجی. همین ریتمِ هر شب است.', 'Three chunks done — 12 records, one job, one output. That is the nightly rhythm.');
await sleep(3000);
}
}
if (prefersReducedMotion.matches) {
statRows.textContent = '12 / 12';
gauge.style.width = '100%';
statStatus.textContent = 'COMPLETE ✓';
statStatus.classList.add('ok');
setQuery('<span class="kw">JOB COMPLETE</span>  —  12 rows loaded');
} else heroLoop();
}

/* ===== Column vs row scan demo ===== */
const grid = $('#storageGrid');
if (grid) {
const headers = ['Id', 'Country', 'Amount', 'Status'];
headers.forEach(h => {
const c = document.createElement('div');
c.className = 'sc sh';
c.textContent = h;
grid.appendChild(c);
});
for (let r = 0; r < 6; r++) {
headers.forEach((h, ci) => {
const c = document.createElement('div');
c.className = 'sc';
c.dataset.col = String(ci);
c.textContent = h === 'Amount' ? String(80 + r * 10) : (h === 'Id' ? String(r + 1) : (h === 'Country' ? 'IR' : 'paid'));
grid.appendChild(c);
});
}
const cells = $$('.sc:not(.sh)', grid);
const ioFill = $('#ioFill'), ioCells = $('#ioCells'), ioVerdict = $('#ioVerdict'), scanSum = $('#scanSum');
const tabRow = $('#tab-row'), tabCol = $('#tab-col');
let scanning = false, pending = null, autoRan = false;
function resetScan() {
cells.forEach(c => c.classList.remove('hit', 'rowhit', 'dim'));
ioFill.style.width = '0%';
ioFill.classList.remove('good');
ioCells.textContent = 'disk read: 0 / 24 cells';
scanSum.textContent = '…';
setBilingual(ioVerdict, 'در حال اسکن…', 'Scanning…');
}
function countUp(to) {
const t0 = performance.now(), d = 480;
(function f(t) {
const k = Math.min(1, (t - t0) / d);
scanSum.textContent = String(Math.round(to * k));
if (k < 1) requestAnimationFrame(f);
})(t0);
}
async function runScan(mode) {
if (scanning) { pending = mode; return; }
scanning = true;
resetScan();
const isCol = mode === 'col';
const targets = isCol ? cells.filter(c => c.dataset.col === '2') : cells;
let read = 0;
for (const c of targets) {
c.classList.add(isCol ? 'hit' : 'rowhit');
read++;
ioFill.style.width = (read / 24 * 100) + '%';
ioCells.textContent = `disk read: ${read} / 24 cells`;
await sleep(isCol ? 80 : 34);
}
if (isCol) ioFill.classList.add('good');
cells.forEach(c => { if (!targets.includes(c)) c.classList.add('dim'); });
countUp(630);
if (isCol) setBilingual(ioVerdict, 'فقط ۶ خانه از ۲۴ — ۷۵٪ I/O کمتر برای همان جمع.', 'Only 6 of 24 cells — 75% less I/O for the same sum.');
else setBilingual(ioVerdict, '۲۴ خانه از ۲۴ خوانده شد — حتی ستون‌هایی که کوئری نمی‌خواهد.', 'All 24 cells read — including columns the query never touches.');
scanning = false;
if (pending && pending !== mode) { const m = pending; pending = null; runScan(m); }
else pending = null;
}
function pick(mode) {
tabRow.setAttribute('aria-selected', String(mode === 'row'));
tabCol.setAttribute('aria-selected', String(mode === 'col'));
runScan(mode);
}
tabRow.addEventListener('click', () => pick('row'));
tabCol.addEventListener('click', () => pick('col'));
const scanObs = new IntersectionObserver(entries => {
entries.forEach(e => {
if (e.isIntersecting && !autoRan) { autoRan = true; scanObs.disconnect(); setTimeout(() => runScan('row'), 350); }
});
}, { threshold: .4 });
scanObs.observe($('#colDemo'));
}

/* ===== Pipeline visualizer (flying chips) ===== */
const flightLayer = $('#flightLayer');
if (flightLayer) {
const ORDERS = [
{ id: 1, c: 'IR', a: 120 }, { id: 2, c: 'DE', a: 80 }, { id: 3, c: 'US', a: 200 }, { id: 4, c: 'IR', a: 90 },
{ id: 5, c: 'US', a: 50 }, { id: 6, c: 'DE', a: 60 }, { id: 7, c: 'IR', a: 40 }, { id: 8, c: 'US', a: 150 },
{ id: 9, c: 'DE', a: 70 }, { id: 10, c: 'IR', a: 80 }, { id: 11, c: 'US', a: 30 }, { id: 12, c: 'US', a: 110 }
];
const trays = { src: $('#listSrc'), a: $('#listA'), b: $('#listB'), c: $('#listC'), out: $('#listOut') };
const nodes = { src: $('#pnSrc'), a: $('#pnA'), b: $('#pnB'), c: $('#pnC'), out: $('#pnOut') };
const counts = { src: $('#cntSrc'), a: $('#cntA'), b: $('#cntB'), c: $('#cntC'), out: $('#cntOut') };
const stTrips = $('#stTrips'), stRecs = $('#stRecs'), stPayload = $('#stPayload'), stTime = $('#stTime');
let mode = 'batch', model = 'etl', running = false;
let trips = 0, done = 0, elapsed = 0;

function makeChip(o) {
const s = document.createElement('span');
s.className = `rec ${o.c.toLowerCase()}`;
s.textContent = model === 'mr' ? `${o.c}:${o.a}` : `#${o.id}`;
s.dataset.id = String(o.id);
return s;
}
function refreshCounts() {
for (const k of Object.keys(trays)) counts[k].textContent = String(trays[k].children.length);
}
function resetViz() {
Object.values(trays).forEach(t => t.innerHTML = '');
flightLayer.innerHTML = '';
ORDERS.forEach(o => trays.src.appendChild(makeChip(o)));
trips = 0; done = 0; elapsed = 0;
stTrips.textContent = '0';
stRecs.textContent = '0 / 12';
stTime.textContent = '0.0s';
stPayload.textContent = mode === 'batch' ? '× 4' : '× 1';
refreshCounts();
setBilingual($('#pipeStatus'), 'یک حالت را انتخاب کنید و اجرا را بزنید.', 'Pick a mode and press run.');
}
function setModelLabels() {
$('#labA').textContent = model === 'etl' ? 'Extract' : 'Map';
$('#labB').textContent = model === 'etl' ? 'Transform' : 'Shuffle';
$('#labC').textContent = model === 'etl' ? 'Load' : 'Reduce';
}
function bumpStats() {
stTrips.textContent = String(trips);
stRecs.textContent = `${done} / 12`;
stTime.textContent = elapsed.toFixed(1) + 's';
}
function fly(chip, toTray, dur, targetNode) {
return new Promise(res => {
const from = chip.getBoundingClientRect();
const to = toTray.getBoundingClientRect();
const lr = flightLayer.getBoundingClientRect();
chip.classList.add('ghosted');
const x0 = from.left - lr.left, y0 = from.top - lr.top;
const x1 = to.left - lr.left + to.width / 2 - from.width / 2 + (Math.random() * 26 - 13);
const y1 = to.top - lr.top + to.height / 2 - from.height / 2 + (Math.random() * 12 - 6);
const g = chip.cloneNode(true);
g.classList.remove('ghosted');
g.classList.add('flying');
flightLayer.appendChild(g);
const mx = (x0 + x1) / 2, my = Math.min(y0, y1) - 26;
if (targetNode) targetNode.classList.add('hot');
const anim = g.animate([
{ transform: `translate(${x0}px, ${y0}px) scale(1)` },
{ transform: `translate(${mx}px, ${my}px) scale(1.08)`, offset: .55 },
{ transform: `translate(${x1}px, ${y1}px) scale(1)` }
], { duration: dur, easing: 'cubic-bezier(.3,.1,.3,1)' });
anim.onfinish = () => {
g.remove();
chip.classList.remove('ghosted');
toTray.appendChild(chip);
chip.classList.add('landed');
setTimeout(() => chip.classList.remove('landed'), 320);
refreshCounts();
res();
};
});
}
async function moveChunk(chunk, fromTray, toTray, dur, stagger, targetNode) {
await Promise.all(chunk.map((c, i) => sleep(i * stagger).then(() => fly(c, toTray, dur, targetNode))));
if (targetNode) setTimeout(() => targetNode.classList.remove('hot'), 160);
}
async function runBatch() {
const chunkSize = 4, dur = 430, stagger = 75;
const hopMs = (dur + stagger * (chunkSize - 1)) / 1000;
for (let i = 0; i < 12; i += chunkSize) {
const chunk = [...trays.src.children].slice(0, chunkSize);
let cur = trays.src;
const stages = [
['a', model === 'etl' ? `استخراج دستهٔ ${i / chunkSize + 1}: چهار رکورد با هم حرکت می‌کنند.` : `Map دستهٔ ${i / chunkSize + 1}: کلید کشور برای هر رکورد ساخته شد.`,
model === 'etl' ? `Extract chunk ${i / chunkSize + 1}: four records move together.` : `Map chunk ${i / chunkSize + 1}: a country key is emitted per record.`],
['b', model === 'etl' ? 'تبدیل: فقط سفارش‌های معتبر نگه داشته می‌شوند.' : 'Shuffle: مقادیر هر کشور کنار هم قرار می‌گیرند.',
model === 'etl' ? 'Transform: only valid orders are kept.' : 'Shuffle: values for each country are grouped.'],
['c', model === 'etl' ? 'بارگذاری: دسته به مقصد می‌رسد.' : 'Reduce: جمع‌های جزئی هر کشور به‌روز می‌شوند.',
model === 'etl' ? 'Load: the chunk reaches its destination.' : 'Reduce: partial sums are updated.']
];
for (const [key, fa, en] of stages) {
setBilingual($('#pipeStatus'), fa, en);
await moveChunk(chunk, cur, trays[key], dur, stagger, nodes[key]);
cur = trays[key];
trips++; elapsed += hopMs; bumpStats();
}
setBilingual($('#pipeStatus'), 'نوشتن دسته در خروجی…', 'Writing the chunk to the output…');
await landChunk(chunk, dur, stagger);
trips++; elapsed += hopMs; done += chunkSize; bumpStats();
}
}
async function runStream() {
const dur = 190, hopMs = dur / 1000;
const recs = [...trays.src.children];
const paths = recs.map((chip, idx) => sleep(idx * 240).then(async () => {
let cur = trays.src;
for (const key of ['a', 'b', 'c']) {
await fly(chip, trays[key], dur, nodes[key]);
trips++; elapsed += hopMs; bumpStats();
cur = trays[key];
}
await landOne(chip, dur);
trips++; elapsed += hopMs; done++; bumpStats();
}));
setBilingual($('#pipeStatus'), 'جریان: هر رکورد تنها سفر می‌کند — ۱۲ سفر هم‌زمان، اما هر سفر فقط یک رکورد می‌برد.', 'Stream: each record travels alone — 12 concurrent trips, but each carries a single record.');
await Promise.all(paths);
}
async function landChunk(chunk, dur, stagger) {
if (model === 'etl') {
await moveChunk(chunk, trays.c, trays.out, dur, stagger, nodes.out);
setTimeout(() => nodes.out.classList.remove('hot'), 160);
} else {
await Promise.all(chunk.map((c, i) => sleep(i * stagger).then(() => fly(c, trays.out, dur, nodes.out).then(() => {
const agg = trays.out.querySelector(`[data-key="${c.dataset.key || ORDERS.find(o => String(o.id) === c.dataset.id).c}"]`);
c.remove();
bumpAgg(agg, ORDERS.find(o => String(o.id) === c.dataset.id));
refreshCounts();
}))));
setTimeout(() => nodes.out.classList.remove('hot'), 160);
}
}
async function landOne(chip, dur) {
if (model === 'etl') {
await fly(chip, trays.out, dur, nodes.out);
} else {
const o = ORDERS.find(x => String(x.id) === chip.dataset.id);
await fly(chip, trays.out, dur, nodes.out);
let agg = trays.out.querySelector(`[data-key="${o.c}"]`);
chip.remove();
bumpAgg(agg, o);
refreshCounts();
}
}
function ensureAggs() {
if (model !== 'mr' || trays.out.children.length) return;
['IR', 'DE', 'US'].forEach(k => {
const s = document.createElement('span');
s.className = 'rec agg';
s.dataset.key = k;
s.dataset.total = '0';
s.textContent = `${k}=0`;
trays.out.appendChild(s);
});
}
function bumpAgg(agg, o) {
if (!agg) return;
const t = Number(agg.dataset.total) + o.a;
agg.dataset.total = String(t);
agg.textContent = `${agg.dataset.key}=${t}`;
agg.classList.remove('landed');
void agg.offsetWidth;
agg.classList.add('landed');
}
async function runPipeline() {
if (running) return;
running = true;
$('#runPipeline').disabled = true;
resetViz();
if (model === 'mr') ensureAggs();
if (mode === 'batch') await runBatch(); else await runStream();
if (model === 'mr') {
setBilingual($('#pipeStatus'),
`تمام. Reduce سه خروجی ساخت: IR=330، DE=210، US=540 — با ${trips} انتقال شبکه.`,
`Done. Reduce built three outputs: IR=330, DE=210, US=540 — with ${trips} network trips.`);
} else if (mode === 'batch') {
setBilingual($('#pipeStatus'),
`تمام. ۱۲ رکورد با ${trips} انتقال — هر انتقال ۴ رکورد را با هم برد.`,
`Done. 12 records in ${trips} trips — each trip carried 4 records together.`);
} else {
setBilingual($('#pipeStatus'),
`تمام. همان ۱۲ رکورد، اما با ${trips} انتقال تک‌رکوردی — ۴ برابر بیشتر از حالت دسته.`,
`Done. The same 12 records, but with ${trips} single-record trips — 4× more than batch mode.`);
}
running = false;
$('#runPipeline').disabled = false;
}
$('#modeBatch').addEventListener('click', () => {
if (running) return;
mode = 'batch';
$('#modeBatch').setAttribute('aria-pressed', 'true');
$('#modeStream').setAttribute('aria-pressed', 'false');
resetViz();
});
$('#modeStream').addEventListener('click', () => {
if (running) return;
mode = 'stream';
$('#modeStream').setAttribute('aria-pressed', 'true');
$('#modeBatch').setAttribute('aria-pressed', 'false');
resetViz();
});
$('#modelEtl').addEventListener('click', () => {
if (running) return;
model = 'etl';
$('#modelEtl').setAttribute('aria-selected', 'true');
$('#modelMr').setAttribute('aria-selected', 'false');
setModelLabels();
resetViz();
});
$('#modelMr').addEventListener('click', () => {
if (running) return;
model = 'mr';
$('#modelMr').setAttribute('aria-selected', 'true');
$('#modelEtl').setAttribute('aria-selected', 'false');
setModelLabels();
resetViz();
});
$('#runPipeline').addEventListener('click', runPipeline);
$('#resetPipeline').addEventListener('click', () => { if (!running) resetViz(); });
setModelLabels();
resetViz();
}

/* ===== Q&A ===== */
$$('.qa-question').forEach(q => {
q.addEventListener('click', () => {
const item = q.closest('.qa');
const open = item.classList.toggle('open');
q.setAttribute('aria-expanded', String(open));
});
});
$('#toggleAllQuestions').addEventListener('click', () => {
const qs = $$('.qa-question');
const openAll = qs.some(q => q.getAttribute('aria-expanded') !== 'true');
qs.forEach(q => { q.closest('.qa').classList.toggle('open', openAll); q.setAttribute('aria-expanded', String(openAll)); });
});
})();
</script>
</body>
